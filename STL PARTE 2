void menuIngresar(vector<Estudiante>& v)
{
    int donde,tipo,indice=0;
    cout<<"1. Al final"<<endl;
    cout<<"2. En un indice: "<<endl;
    cin>>donde;

    if(donde==2){

        cout<<"Indice (0 a "<<v.size()<<"): ";
        cin>>indice;
    }

    cout<<"1. Por defecto (NN,0,0,0)"<<endl;
    cout<<"2. Con datos: "<<endl;
    cin>>tipo;

    Estudiante e;

    if(tipo==2){

        e=leerEstudiante();
    }

    if(donde==1){

