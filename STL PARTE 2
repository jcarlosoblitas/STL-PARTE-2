}

void menuEliminar(vector<Estudiante>&v)
{
    if(v.empty()){

        cout<<"No hay estudiantes para eliminar"<<endl;

        return;
    }

    int op,indice;

    cout<<"1. Eliminar el ultimo"<<endl;
    cout<<"2. Eliminar desde un indice: "<<endl;
    cin>>op;


    if(op==1){

        eliminarUltimo(v);
    }

    else if(op==2){

        cout<<"Indice (0 a "<< v.size()-1<<"): ";
        cin>>indice;
        eliminarIndice(v,indice);
    }
}

void menuActualizar(vector<Estudiante>&v)
{
    if(v.empty()){

        cout<<"No hay estudiantes para actualizar"<<endl;
        return;
    }

    int indice;
    cout<<"Indice a actualizar (0 a "<<v.size()-1<< "): ";
    cin>>indice;

    if(indice<0 || indice>=(int)v.size()){

        cout<<"Indice no valido"<<endl;
        return;
    }

    Estudiante e=leerEstudiante();
    actualizar(v,indice,e.getNombre(),e.getAnio(),e.getGpa(),e.getPresupuesto());
}

void menuOrdenar(vector<Estudiante>& v)
{
    int op;
    cout<<"Ordenar por:"<<endl;
        cout<<"1. Anio"<<endl;
